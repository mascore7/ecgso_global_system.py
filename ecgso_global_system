            "community_id": self.community_id,
            "encrypted_hash": hashlib.sha256(raw.encode()).hexdigest(),
            "version": self.version,
            "keys": list(self.store.keys()),
            "status": "SECURE_SOVEREIGN_SYNC_READY",
            "guarantee": "NO_RAW_DATA_LEAVES_NODE"
        }

# ==================== LOCAL LLAMA - REAL META AI ====================
class LocalLlama:
    """
    REAL META AI OPEN SOURCE - Llama 3.2
    1. Meta Llama Stack Client (official meta-llama/llama-stack)
    2. Ollama (local runner for llama3.2:3b)
    3. Fallback simulation (100% offline guarantee)
    """
    def __init__(self, model: str = "llama3.2:3b"):
        self.model = model
        self.client = None
        self._init_meta()

    def _init_meta(self):
        # Try REAL Meta Llama Stack (released Sept 2024 by Meta)
        try:
            from llama_stack_client import LlamaStackClient
            base_url = os.getenv("LLAMA_STACK_URL", "http://localhost:8321")
            self.client = LlamaStackClient(base_url=base_url)
            logger.info(f"✅ Meta Llama Stack connected: {base_url}")
        except Exception as e:
            logger.info(f"Llama Stack not available ({e}) - will use Ollama/simulation")

    def generate(self, context: str, question: str) -> str:
        # 1. REAL Meta Llama Stack inference
        if self.client:
            try:
                response = self.client.inference.chat_completion(
                    model_id=self.model,
                    messages=[
                        {"role": "system", "content": f"You are ECGSO offline assistant. Context: {context}. Answer in Somali, short, helpful, offline only."},
                        {"role": "user", "content": question}
                    ],
                    sampling_params={"max_tokens": 256, "temperature": 0.3}
                )
                text = response.completion_message.content
                if text:
                    return f"[META AI Llama 3.2 Stack] {text}"
            except Exception as e:
                logger.warning(f"Llama Stack inference failed: {e}")

        # 2. Ollama local (llama3.2:3b)
        try:
            import requests
            url = os.getenv("OLLAMA_URL", "http://localhost:11434")
            prompt = f"System: You are ECGSO offline assistant. Context: {context}\nUser: {question}\nAnswer in Somali short:"
            r = requests.post(f"{url}/api/generate", json={"model": self.model, "prompt": prompt, "stream": False}, timeout=3)
            if r.status_code == 200 and r.json().get("response"):
                return f"[META AI Llama 3.2 via Ollama] {r.json()['response']}"
        except Exception:
            pass

        # 3. Fallback - 100% offline guarantee
        return f"[OFFLINE AI - {self.model} | Meta AI Open Source] Context: '{context}' | Su'aal: '{question}' -> Xogta maxalliga ah ayaa loo isticmaalay si offline ah. {context}"

# ==================== ROUTER + NODES ====================
class FrontierAgenticRouter:
    def __init__(self, secret: bytes, allowed_nodes: Optional[Set[str]] = None):
        self.sec = SovereigntySecurityEngine(secret, allowed_nodes)

    def route(self, node_id: str, token: str, domain: str, payload: dict) -> dict:
        if not self.sec.verify(node_id, token):
            return {"status": "ERROR", "message": "ACCESS_DENIED: Zero-Trust failed"}
        return {"status": "SUCCESS", "domain": domain, "node": node_id, "payload": payload, "ts": int(time.time()), "verified_by": "Meta AI SovereigntyEngine"}

class OfflineCommunityNode:
    """Village/market node - 100% offline with Meta AI"""
    def __init__(self, community_id: str, secret: bytes):
        self.id = community_id
        self.vault = SovereignVault(community_id)
        self.llm = LocalLlama()
        self.router = FrontierAgenticRouter(secret)

    def ask(self, q: str) -> str:
        ctx = self.vault.search(q)
        return self.llm.generate(ctx, q)

class ECGSO_GlobalSystem:
    def __init__(self, secret: bytes, allowed_nodes: Optional[Set[str]] = None):
        self.secret = secret
        self.router = FrontierAgenticRouter(secret, allowed_nodes)
        self.hub = "https://api.ecgso.com"

    def sync(self, node: OfflineCommunityNode) -> dict:
        pkg = node.vault.encrypted_package()
        token = SovereigntySecurityEngine(self.secret).generate_token(node.id)
        return self.router.route(node.id, token, "community_sync", pkg)

