        self.store = {
            "mushaarka_suuqa": "Qiimaha suuqa Garowe: Bariis 50kg = $45, Saliid 20L = $30",
            "xeerarka_bulshada": "Wadashaqeyn, kalsooni, wadaagid kheyraadka",
            "cimilada": "Garowe: 32°C, kulayl, roob yar"
        }
