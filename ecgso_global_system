# ==================== SOVEREIGNTY SECURITY - ZERO TRUST FIXED ====================
class SovereigntySecurityEngine:
    """
    Zero-Trust HMAC Security - FIXED PRODUCTION VERSION
    Bug fixed: time.time() // 300 -> int(time.time()) // 300 (float bug)
    Features: Replay protection, ACL, Clock tolerance
    """
    def __init__(self, master_secret: bytes, allowed_nodes: Optional[Set[str]] = None):
        self.master_secret = master_secret
        self.allowed_nodes = allowed_nodes or set()
        self._used_tokens: Dict[str, float] = {}
        self._lock = threading.Lock()
        self.ttl = 600  # 10 min

    @staticmethod
    def _window() -> int:
        return int(time.time()) // 300  # 5-min window - FIXED int()

    def generate_token(self, community_id: str) -> str:
        msg = f"{community_id}:{self._window()}".encode()
        return hmac.new(self.master_secret, msg, hashlib.sha256).hexdigest()

    def verify(self, node_id: str, token: str) -> bool:
        # ACL
        if self.allowed_nodes and node_id not in self.allowed_nodes:
            logger.warning(f"ACL DENY {node_id}")
            return False
        # Replay + cleanup
        with self._lock:
            now = time.time()
            self._used_tokens = {k: v for k, v in self._used_tokens.items() if now - v < self.ttl}
            if token in self._used_tokens:
                logger.warning(f"REPLAY {node_id}")
                return False
        # Tolerance -1,0
        for offset in [-1, 0]:
            w = self._window() + offset
            exp = hmac.new(self.master_secret, f"{node_id}:{w}".encode(), hashlib.sha256).hexdigest()
            if hmac.compare_digest(token, exp):
                with self._lock:
                    self._used_tokens[token] = time.time()
                logger.info(f"VERIFY OK {node_id} w={w}")
                return True
        logger.warning(f"VERIFY FAIL {node_id}")
        return False

