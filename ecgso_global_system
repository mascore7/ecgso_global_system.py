            return self.store["mushaarka_suuqa"]
        return "Xogta maxalliga ah weli lama diiwaangelin - SovereignVault local only"

    def encrypted_package(self) -> dict:
        raw = json.dumps(self.store, sort_keys=True, ensure_ascii=False)
